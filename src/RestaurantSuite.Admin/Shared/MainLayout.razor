@inherits LayoutComponentBase

<PageTitle>Restaurant Suite - Admin Portal</PageTitle>

<div id="main-layout" class="min-h-screen bg-slate-50">
    <!-- Top Header -->
    <header id="main-header" class="bg-white border-b border-slate-200 sticky top-0 z-50">
        <div id="main-header-container" class="px-4 sm:px-6 lg:px-8">
            <div id="main-header-content" class="flex items-center justify-between h-16">
                <!-- Left Section -->
                <div id="main-header-left" class="flex items-center">
                    <!-- Mobile Menu Button -->
                    <button id="mobile-menu-btn" @onclick="ToggleSidebar" 
                            class="lg:hidden p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100">
                        <svg id="mobile-menu-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>
                    
                    <!-- Logo -->
                    <div id="main-logo" class="flex items-center ml-4 lg:ml-0">
                        <div id="logo-container" class="flex-shrink-0">
                            <div id="logo-icon" class="w-8 h-8 bg-primary-600 rounded-lg flex items-center justify-center">
                                <svg id="logo-svg" class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L3 7V17C3 18.1046 3.89543 19 5 19H19C20.1046 19 21 18.1046 21 17V7L12 2Z"/>
                                    <circle cx="12" cy="12" r="2" fill="currentColor"/>
                                </svg>
                            </div>
                        </div>
                        <div id="logo-text" class="ml-3">
                            <h1 id="app-title" class="text-xl font-semibold text-slate-900">Restaurant Suite</h1>
                        </div>
                    </div>
                </div>

                <!-- Right Section -->
                <div id="main-header-right" class="flex items-center space-x-4">
                    <!-- Notifications -->
                    <button id="notifications-btn" class="p-2 rounded-md text-slate-600 hover:text-slate-900 hover:bg-slate-100 relative">
                        <svg id="notifications-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
                        </svg>
                        <span id="notifications-badge" class="absolute top-1 right-1 w-2 h-2 bg-red-500 rounded-full"></span>
                    </button>

                    <!-- User Menu -->
                    <div id="user-menu-container" class="relative">
                        <button id="user-menu-btn" @onclick="ToggleUserMenu" class="flex items-center space-x-3 p-2 rounded-md hover:bg-slate-100">
                            <div id="user-avatar" class="w-8 h-8 bg-slate-200 rounded-full flex items-center justify-center">
                                <svg id="user-avatar-icon" class="w-5 h-5 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                </svg>
                            </div>
                            <span id="user-name" class="hidden sm:block text-sm font-medium text-slate-700">Admin User</span>
                            <svg id="user-menu-chevron" class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                            </svg>
                        </button>
                        
                        @if (userMenuOpen)
                        {
                            <div id="user-menu-dropdown" class="absolute right-0 mt-2 w-48 bg-white rounded-md shadow-lg py-1 z-50 border border-slate-200">
                                <a href="#" id="user-menu-profile" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Profile</a>
                                <a href="#" id="user-menu-settings" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Settings</a>
                                <hr id="user-menu-divider" class="my-1">
                                <a href="#" id="user-menu-signout" class="block px-4 py-2 text-sm text-slate-700 hover:bg-slate-100">Sign out</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </header>

    <div id="main-content-wrapper" class="flex">
        <!-- Sidebar -->
        <aside id="sidebar" class="@GetSidebarClasses()">
            <nav id="sidebar-nav" class="mt-8 px-4">
                <ul id="sidebar-nav-list" class="space-y-2">
                    <li id="nav-item-dashboard">
                        <NavLink id="nav-link-dashboard" href="" Match="NavLinkMatch.All" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-dashboard" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                            </svg>
                            Dashboard
                        </NavLink>
                    </li>
                    <li id="nav-item-orders">
                        <NavLink id="nav-link-orders" href="orders" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-orders" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                            </svg>
                            Orders
                        </NavLink>
                    </li>
                    <li id="nav-item-menu">
                        <NavLink id="nav-link-menu" href="menu" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-menu" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                            </svg>
                            Menu
                        </NavLink>
                    </li>
                    <li id="nav-item-recipes">
                        <NavLink id="nav-link-recipes" href="recipes" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-recipes" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                            </svg>
                            Recipes
                        </NavLink>
                    </li>
                    <li id="nav-item-stock">
                        <NavLink id="nav-link-stock" href="stock" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-stock" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                            </svg>
                            Stock
                        </NavLink>
                    </li>
                    <li id="nav-item-tables">
                        <NavLink id="nav-link-tables" href="tables" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-tables" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                            </svg>
                            Tables
                        </NavLink>
                    </li>
                    <li id="nav-item-staff">
                        <NavLink id="nav-link-staff" href="staff" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-staff" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>
                            </svg>
                            Staff
                        </NavLink>
                    </li>
                    <li id="nav-item-reports">
                        <NavLink id="nav-link-reports" href="reports" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-reports" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                            </svg>
                            Reports
                        </NavLink>
                    </li>
                    <li id="nav-item-settings">
                        <NavLink id="nav-link-settings" href="settings" class="flex items-center px-4 py-3 text-slate-700 rounded-lg hover:bg-slate-100 transition-colors">
                            <svg id="nav-icon-settings" class="w-5 h-5 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                            </svg>
                            Settings
                        </NavLink>
                    </li>
                </ul>
            </nav>
        </aside>

        <!-- Mobile Overlay -->
        @if (sidebarOpen)
        {
            <div id="mobile-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-40 lg:hidden" @onclick="ToggleSidebar"></div>
        }

        <!-- Main Content -->
        <main id="main-content" class="flex-1 p-6 lg:p-8">
            <div id="main-content-container" class="max-w-7xl mx-auto">
                @Body
            </div>
        </main>
    </div>
</div>

@code {
    private bool sidebarOpen = false;
    private bool userMenuOpen = false;

    private void ToggleSidebar()
    {
        sidebarOpen = !sidebarOpen;
    }

    private void ToggleUserMenu()
    {
        userMenuOpen = !userMenuOpen;
    }

    private string GetSidebarClasses()
    {
        var baseClasses = "fixed inset-y-0 left-0 z-50 w-64 bg-white border-r border-slate-200 transform transition-transform duration-300 ease-in-out lg:relative lg:translate-x-0";
        var mobileClasses = sidebarOpen ? "translate-x-0" : "-translate-x-full";
        return $"{baseClasses} {mobileClasses}";
    }
}

@page "/inventory"
@using RestaurantSuite.Application.DTOs
@using RestaurantSuite.Application.Commands
@using RestaurantSuite.Domain.Enums
@inject Services.ApiService ApiService

<PageTitle>Inventory Management - Restaurant Suite</PageTitle>

<!-- Page Header -->
<div id="inventory-header" class="inventory-header">
    <div id="inventory-header-content" class="inventory-header-content">
        <div id="inventory-header-text">
            <h1 id="inventory-title" class="inventory-title">Inventory Management</h1>
            <p id="inventory-subtitle" class="inventory-subtitle">Track stock levels, manage ingredients, and monitor consumption.</p>
        </div>
        <button id="inventory-add-item-btn" @onclick="ShowAddItemModal" class="add-item-btn">
            <svg id="inventory-add-item-icon" class="add-item-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
            </svg>
            Add Item
        </button>
    </div>
</div>

<!-- Inventory Stats -->
<div class="inventory-stats-grid">
    <div class="inventory-stat-card">
        <div class="inventory-stat-content">
            <div>
                <p class="inventory-stat-label">Total Items</p>
                <p class="inventory-stat-value">@inventoryItems.Count</p>
                <p class="inventory-stat-note">Active inventory</p>
            </div>
            <div class="inventory-stat-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
            </div>
        </div>
    </div>

    <div class="inventory-stat-card low-stock-card">
        <div class="inventory-stat-content">
            <div>
                <p class="inventory-stat-label">Low Stock Items</p>
                <p class="inventory-stat-value">@lowStockCount</p>
                <p class="inventory-stat-note">Need reordering</p>
            </div>
            <div class="inventory-stat-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
        </div>
    </div>

    <div class="inventory-stat-card">
        <div class="inventory-stat-content">
            <div>
                <p class="inventory-stat-label">Total Value</p>
                <p class="inventory-stat-value">${totalValue:F2}</p>
                <p class="inventory-stat-note">Current stock</p>
            </div>
            <div class="inventory-stat-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Filter and Search -->
<div class="inventory-filters">
    <div class="search-box">
        <input type="text" @bind="searchTerm" @bind:event="oninput" placeholder="Search inventory..." class="search-input" />
    </div>
    <div class="filter-buttons">
        <button class="filter-btn @(showOnlyLowStock ? "active" : "")" @onclick="ToggleLowStockFilter">
            Low Stock Only
        </button>
    </div>
</div>

<!-- Inventory Table -->
<div class="inventory-card">
    @if (isLoading)
    {
        <div class="loading-container">
            <div class="loading-spinner">
                <svg class="spinner-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Loading inventory...
            </div>
        </div>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="error-container">
            <p class="error-message">@errorMessage</p>
        </div>
    }
    else if (filteredItems.Any())
    {
        <div class="inventory-table-container">
            <table class="inventory-table">
                <thead>
                    <tr>
                        <th>Item Name</th>
                        <th>SKU</th>
                        <th>Current Stock</th>
                        <th>Unit</th>
                        <th>Min Level</th>
                        <th>Unit Cost</th>
                        <th>Total Value</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in filteredItems)
                    {
                        <tr class="@(item.IsLowStock ? "low-stock-row" : "")">
                            <td class="item-name-cell">
                                <div class="item-name">@item.Name</div>
                                @if (!string.IsNullOrEmpty(item.Description))
                                {
                                    <div class="item-description">@item.Description</div>
                                }
                            </td>
                            <td>@item.SKU</td>
                            <td class="stock-cell">
                                <span class="@(item.IsLowStock ? "low-stock-value" : "")">
                                    @item.CurrentStock
                                </span>
                            </td>
                            <td>@item.Unit</td>
                            <td>@item.MinimumStockLevel</td>
                            <td>${item.UnitCost:F2}</td>
                            <td>${(item.CurrentStock * item.UnitCost):F2}</td>
                            <td>
                                @if (item.IsLowStock)
                                {
                                    <span class="status-badge status-low-stock">Low Stock</span>
                                }
                                else
                                {
                                    <span class="status-badge status-ok">OK</span>
                                }
                            </td>
                            <td class="actions-cell">
                                <button @onclick="() => ShowAdjustStockModal(item)" class="action-btn action-btn-adjust" title="Adjust Stock">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                                    </svg>
                                </button>
                                <button @onclick="() => ShowEditItemModal(item)" class="action-btn action-btn-edit" title="Edit">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                </button>
                                <button @onclick="() => ShowTransactionHistory(item)" class="action-btn action-btn-history" title="Transaction History">
                                    <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="empty-state">
            <svg class="empty-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
            <h3 class="empty-title">No inventory items found</h3>
            <p class="empty-description">Get started by adding your first inventory item.</p>
        </div>
    }
</div>

<!-- Modals will go here -->
@if (showAddModal || showEditModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-content" @onclick:stopPropagation>
            <h2 class="modal-title">@(showAddModal ? "Add" : "Edit") Inventory Item</h2>

            <div class="form-group">
                <label>Name</label>
                <input type="text" @bind="currentItem.Name" class="form-control" />
            </div>

            <div class="form-group">
                <label>Description</label>
                <input type="text" @bind="currentItem.Description" class="form-control" />
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>SKU</label>
                    <input type="text" @bind="currentItem.SKU" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Unit</label>
                    <select @bind="currentItem.Unit" class="form-control">
                        @foreach (var unit in Enum.GetValues<UnitOfMeasure>())
                        {
                            <option value="@unit">@unit</option>
                        }
                    </select>
                </div>
            </div>

            <div class="form-row">
                <div class="form-group">
                    <label>Initial Stock</label>
                    <input type="number" @bind="currentItem.InitialStock" step="0.01" class="form-control" />
                </div>
                <div class="form-group">
                    <label>Minimum Level</label>
                    <input type="number" @bind="currentItem.MinimumStockLevel" step="0.01" class="form-control" />
                </div>
            </div>

            <div class="form-group">
                <label>Unit Cost</label>
                <input type="number" @bind="currentItem.UnitCost" step="0.01" class="form-control" />
            </div>

            <div class="modal-actions">
                <button @onclick="CloseModals" class="btn-secondary">Cancel</button>
                <button @onclick="SaveItem" class="btn-primary">Save</button>
            </div>
        </div>
    </div>
}

@if (showAdjustModal)
{
    <div class="modal-overlay" @onclick="CloseModals">
        <div class="modal-content" @onclick:stopPropagation>
            <h2 class="modal-title">Adjust Stock - @selectedItem?.Name</h2>

            <div class="form-group">
                <label>Transaction Type</label>
                <select @bind="adjustmentType" class="form-control">
                    @foreach (var type in Enum.GetValues<StockTransactionType>())
                    {
                        <option value="@type">@type</option>
                    }
                </select>
            </div>

            <div class="form-group">
                <label>Quantity</label>
                <input type="number" @bind="adjustmentQuantity" step="0.01" class="form-control" />
                <small class="form-text">Current stock: @selectedItem?.CurrentStock @selectedItem?.Unit</small>
            </div>

            <div class="form-group">
                <label>Notes</label>
                <textarea @bind="adjustmentNotes" class="form-control" rows="3"></textarea>
            </div>

            <div class="modal-actions">
                <button @onclick="CloseModals" class="btn-secondary">Cancel</button>
                <button @onclick="SaveAdjustment" class="btn-primary">Save Adjustment</button>
            </div>
        </div>
    </div>
}

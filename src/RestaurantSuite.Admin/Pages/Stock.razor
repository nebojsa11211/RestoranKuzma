@page "/stock"
@attribute [Authorize(Roles = "Admin")]
@using RestaurantSuite.Admin.Services
<PageTitle>Stock Management - Restaurant Suite</PageTitle>

<!-- Page Header -->
<div id="stock-header" class="mb-8">
    <div id="stock-header-content" class="flex items-center justify-between">
        <div id="stock-header-text">
            <h1 id="stock-title" class="text-3xl font-bold text-slate-900">Stock Management</h1>
            <p id="stock-subtitle" class="text-slate-600 mt-2">Monitor and manage inventory stock levels.</p>
        </div>
        <div class="flex gap-3">
            <button id="add-stock-btn" @onclick="ShowAddStockModal" class="flex items-center px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                <svg id="add-stock-icon" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                </svg>
                Add Stock Item
            </button>
        </div>
    </div>
</div>

<!-- Stock Stats -->
<div id="stock-stats" class="grid grid-cols-1 md:grid-cols-4 gap-6 mb-8">
    <div id="total-items-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="total-items-content" class="flex items-center justify-between">
            <div id="total-items-text">
                <p id="total-items-label" class="text-sm font-medium text-slate-600">Total Items</p>
                <p id="total-items-value" class="text-2xl font-bold text-slate-900 mt-1">@stockItems.Count</p>
            </div>
            <div id="total-items-icon" class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                </svg>
            </div>
        </div>
    </div>

    <div id="low-stock-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="low-stock-content" class="flex items-center justify-between">
            <div id="low-stock-text">
                <p id="low-stock-label" class="text-sm font-medium text-slate-600">Low Stock</p>
                <p id="low-stock-value" class="text-2xl font-bold text-red-600 mt-1">@lowStockCount</p>
            </div>
            <div id="low-stock-icon" class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
                </svg>
            </div>
        </div>
    </div>

    <div id="out-of-stock-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="out-of-stock-content" class="flex items-center justify-between">
            <div id="out-of-stock-text">
                <p id="out-of-stock-label" class="text-sm font-medium text-slate-600">Out of Stock</p>
                <p id="out-of-stock-value" class="text-2xl font-bold text-orange-600 mt-1">@outOfStockCount</p>
            </div>
            <div id="out-of-stock-icon" class="w-12 h-12 bg-orange-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                </svg>
            </div>
        </div>
    </div>

    <div id="stock-value-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="stock-value-content" class="flex items-center justify-between">
            <div id="stock-value-text">
                <p id="stock-value-label" class="text-sm font-medium text-slate-600">Total Value</p>
                <p id="stock-value-value" class="text-2xl font-bold text-green-600 mt-1">RSD @totalStockValue.ToString("N0")</p>
            </div>
            <div id="stock-value-icon" class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Stock Items Table -->
<div id="stock-table-container" class="bg-white rounded-xl shadow-sm border border-slate-200">
    <div id="stock-table-header" class="px-6 py-4 border-b border-slate-200">
        <h2 id="stock-table-title" class="text-lg font-semibold text-slate-900">Stock Items</h2>
    </div>
    <div id="stock-table-wrapper" class="overflow-x-auto">
        <table id="stock-table" class="w-full">
            <thead class="bg-slate-50 border-b border-slate-200">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Item Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Category</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Current Stock</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Unit</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Min Level</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Unit Price</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Status</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-slate-600 uppercase tracking-wider">Actions</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-slate-200">
                @if (stockItems != null && stockItems.Any())
                {
                    foreach (var item in stockItems)
                    {
                        <tr class="hover:bg-slate-50">
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-medium text-slate-900">@item.Name</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-slate-600">@item.Category</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm font-semibold text-slate-900">@item.CurrentStock</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-slate-600">@item.Unit</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-slate-600">@item.MinLevel</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                <div class="text-sm text-slate-900">RSD @item.UnitPrice.ToString("N2")</div>
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap">
                                @if (item.CurrentStock <= 0)
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">
                                        Out of Stock
                                    </span>
                                }
                                else if (item.CurrentStock <= item.MinLevel)
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-orange-100 text-orange-800">
                                        Low Stock
                                    </span>
                                }
                                else
                                {
                                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">
                                        In Stock
                                    </span>
                                }
                            </td>
                            <td class="px-6 py-4 whitespace-nowrap text-sm font-medium">
                                <div class="flex items-center space-x-2">
                                    <button @onclick="() => ShowEditStockModal(item)" class="text-primary-600 hover:text-primary-900" title="Edit">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                        </svg>
                                    </button>
                                    <button @onclick="() => DeleteStockItem(item.Id)" class="text-red-600 hover:text-red-900" title="Delete">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="px-6 py-8 text-center text-slate-500">
                            No stock items found. Add your first stock item to get started.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
@page "/"
@attribute [Authorize(Roles = "Admin")]
@using RestaurantSuite.Admin.Services
@using RestaurantSuite.Application.DTOs
@using RestaurantSuite.Domain.Enums

<PageTitle>Dashboard - Restaurant Suite</PageTitle>

<!-- Page Header -->
<div id="dashboard-header" class="mb-8">
    <h1 id="dashboard-title" class="text-3xl font-bold text-slate-900">Dashboard</h1>
    <p id="dashboard-subtitle" class="text-slate-600 mt-2">Welcome back! Here's what's happening at Restoran Kuzma today.</p>
</div>

<!-- Stats Cards -->
<div id="dashboard-stats" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <!-- Total Tables -->
    <div id="total-tables-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="total-tables-content" class="flex items-center justify-between">
            <div id="total-tables-text">
                <p id="total-tables-label" class="text-sm font-medium text-slate-600">Total Tables</p>
                <p id="total-tables-value" class="text-2xl font-bold text-slate-900 mt-1">@totalTables</p>
                <p id="total-tables-note" class="text-sm text-slate-500 mt-2">All available</p>
            </div>
            <div id="total-tables-icon" class="w-12 h-12 bg-blue-100 rounded-lg flex items-center justify-center">
                <svg id="total-tables-svg" class="w-6 h-6 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- Occupied Tables -->
    <div id="occupied-tables-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="occupied-tables-content" class="flex items-center justify-between">
            <div id="occupied-tables-text">
                <p id="occupied-tables-label" class="text-sm font-medium text-slate-600">Occupied</p>
                <p id="occupied-tables-value" class="text-2xl font-bold text-slate-900 mt-1">@occupiedTables</p>
                <p id="occupied-tables-note" class="text-sm text-red-600 mt-2">@occupancyPercentage% capacity</p>
            </div>
            <div id="occupied-tables-icon" class="w-12 h-12 bg-red-100 rounded-lg flex items-center justify-center">
                <svg id="occupied-tables-svg" class="w-6 h-6 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- Available Tables -->
    <div id="available-tables-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="available-tables-content" class="flex items-center justify-between">
            <div id="available-tables-text">
                <p id="available-tables-label" class="text-sm font-medium text-slate-600">Available</p>
                <p id="available-tables-value" class="text-2xl font-bold text-slate-900 mt-1">@availableTables</p>
                <p id="available-tables-note" class="text-sm text-green-600 mt-2">Ready for guests</p>
            </div>
            <div id="available-tables-icon" class="w-12 h-12 bg-green-100 rounded-lg flex items-center justify-center">
                <svg id="available-tables-svg" class="w-6 h-6 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
        </div>
    </div>

    <!-- Reserved Tables -->
    <div id="reserved-tables-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
        <div id="reserved-tables-content" class="flex items-center justify-between">
            <div id="reserved-tables-text">
                <p id="reserved-tables-label" class="text-sm font-medium text-slate-600">Reserved</p>
                <p id="reserved-tables-value" class="text-2xl font-bold text-slate-900 mt-1">@reservedTables</p>
                <p id="reserved-tables-note" class="text-sm text-yellow-600 mt-2">Upcoming reservations</p>
            </div>
            <div id="reserved-tables-icon" class="w-12 h-12 bg-yellow-100 rounded-lg flex items-center justify-center">
                <svg id="reserved-tables-svg" class="w-6 h-6 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Main Content Grid -->
<div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Recent Orders -->
    <div id="recent-orders-section" class="lg:col-span-2">
        <div id="recent-orders-card" class="bg-white rounded-xl shadow-sm border border-slate-200">
            <div id="recent-orders-header" class="px-6 py-4 border-b border-slate-200">
                <div id="recent-orders-title-row" class="flex items-center justify-between">
                    <h2 id="recent-orders-title" class="text-lg font-semibold text-slate-900">Recent Orders</h2>
                    <a id="recent-orders-view-all" href="/orders" class="text-sm text-primary-600 hover:text-primary-700">View all</a>
                </div>
            </div>
            <div id="recent-orders-table-container" class="overflow-x-auto">
                <table id="recent-orders-table" class="min-w-full divide-y divide-slate-200">
                    <thead id="recent-orders-thead" class="bg-slate-50">
                        <tr id="recent-orders-header-row">
                            <th id="recent-orders-col-order-id" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Order ID</th>
                            <th id="recent-orders-col-table" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Table</th>
                            <th id="recent-orders-col-items" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Items</th>
                            <th id="recent-orders-col-total" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Total</th>
                            <th id="recent-orders-col-status" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Status</th>
                            <th id="recent-orders-col-time" class="px-6 py-3 text-left text-xs font-medium text-slate-500 uppercase tracking-wider">Time</th>
                        </tr>
                    </thead>
                    <tbody id="recent-orders-tbody" class="bg-white divide-y divide-slate-200">
                        <tr id="recent-order-row-1">
                            <td id="recent-order-1-id" class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">#1247</td>
                            <td id="recent-order-1-table" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">Table 5</td>
                            <td id="recent-order-1-items" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">3 items</td>
                            <td id="recent-order-1-total" class="px-6 py-4 whitespace-nowrap text-sm text-slate-900 font-medium">RSD 2,850</td>
                            <td id="recent-order-1-status" class="px-6 py-4 whitespace-nowrap">
                                <span id="recent-order-1-status-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">
                                    Completed
                                </span>
                            </td>
                            <td id="recent-order-1-time" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">2 min ago</td>
                        </tr>
                        <tr id="recent-order-row-2">
                            <td id="recent-order-2-id" class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">#1246</td>
                            <td id="recent-order-2-table" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">Table 12</td>
                            <td id="recent-order-2-items" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">2 items</td>
                            <td id="recent-order-2-total" class="px-6 py-4 whitespace-nowrap text-sm text-slate-900 font-medium">RSD 1,650</td>
                            <td id="recent-order-2-status" class="px-6 py-4 whitespace-nowrap">
                                <span id="recent-order-2-status-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-yellow-100 text-yellow-800">
                                    In Kitchen
                                </span>
                            </td>
                            <td id="recent-order-2-time" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">5 min ago</td>
                        </tr>
                        <tr id="recent-order-row-3">
                            <td id="recent-order-3-id" class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">#1245</td>
                            <td id="recent-order-3-table" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">Table 8</td>
                            <td id="recent-order-3-items" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">4 items</td>
                            <td id="recent-order-3-total" class="px-6 py-4 whitespace-nowrap text-sm text-slate-900 font-medium">RSD 3,200</td>
                            <td id="recent-order-3-status" class="px-6 py-4 whitespace-nowrap">
                                <span id="recent-order-3-status-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
                                    Ready
                                </span>
                            </td>
                            <td id="recent-order-3-time" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">8 min ago</td>
                        </tr>
                        <tr id="recent-order-row-4">
                            <td id="recent-order-4-id" class="px-6 py-4 whitespace-nowrap text-sm font-medium text-slate-900">#1244</td>
                            <td id="recent-order-4-table" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">Table 3</td>
                            <td id="recent-order-4-items" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">5 items</td>
                            <td id="recent-order-4-total" class="px-6 py-4 whitespace-nowrap text-sm text-slate-900 font-medium">RSD 4,100</td>
                            <td id="recent-order-4-status" class="px-6 py-4 whitespace-nowrap">
                                <span id="recent-order-4-status-badge" class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
                                    Served
                                </span>
                            </td>
                            <td id="recent-order-4-time" class="px-6 py-4 whitespace-nowrap text-sm text-slate-500">12 min ago</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Info -->
    <div id="quick-actions-info" class="space-y-6">
        <!-- Quick Actions -->
        <div id="quick-actions-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 id="quick-actions-title" class="text-lg font-semibold text-slate-900 mb-4">Quick Actions</h3>
            <div id="quick-actions-buttons" class="space-y-3">
                <button id="new-order-btn" class="w-full flex items-center justify-center px-4 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                    <svg id="new-order-icon" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0v6m0-6h6m-6 0H6"/>
                    </svg>
                    New Order
                </button>
                <button id="update-menu-btn" class="w-full flex items-center justify-center px-4 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">
                    <svg id="update-menu-icon" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
                    </svg>
                    Update Menu
                </button>
                <button id="manage-tables-btn" class="w-full flex items-center justify-center px-4 py-3 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">
                    <svg id="manage-tables-icon" class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                    </svg>
                    Manage Tables
                </button>
            </div>
        </div>

        <!-- Restaurant Info -->
        <div id="restaurant-info-card" class="bg-white rounded-xl shadow-sm border border-slate-200 p-6">
            <h3 id="restaurant-info-title" class="text-lg font-semibold text-slate-900 mb-4">Restaurant Info</h3>
            <div id="restaurant-info-details" class="space-y-4">
                <div id="restaurant-name-group">
                    <p id="restaurant-name-label" class="text-sm text-slate-600">Restaurant Name</p>
                    <p id="restaurant-name-value" class="font-medium text-slate-900">Restoran Kuzma</p>
                </div>
                <div id="restaurant-address-group">
                    <p id="restaurant-address-label" class="text-sm text-slate-600">Address</p>
                    <p id="restaurant-address-value" class="font-medium text-slate-900">123 Main Street, Belgrade</p>
                </div>
                <div id="restaurant-hours-group">
                    <p id="restaurant-hours-label" class="text-sm text-slate-600">Operating Hours</p>
                    <p id="restaurant-hours-value" class="font-medium text-slate-900">11:00 AM - 11:00 PM</p>
                </div>
                <div id="restaurant-phone-group">
                    <p id="restaurant-phone-label" class="text-sm text-slate-600">Phone</p>
                    <p id="restaurant-phone-value" class="font-medium text-slate-900">+381 11 123 4567</p>
                </div>
            </div>
        </div>
    </div>
</div>

@page "/test-button"

<PageTitle>Button Test - Restaurant Suite</PageTitle>

<div class="test-button-container">
    <h1 class="test-title">Button Styling Test</h1>
    
    <div class="space-y-4">
        <div class="button-group">
            <h2 class="test-section-title">Primary Button Test</h2>
            <button class="primary-button">
                Edit
            </button>
        </div>
        
        <div class="button-group">
            <h2 class="test-section-title">Button with All Classes</h2>
            <button class="test-button">
                Test Button
            </button>
        </div>
        
        <div class="button-group">
            <h2 class="test-section-title">Button States</h2>
            <div class="button-row">
                <button class="state-button state-button-normal">
                    Normal
                </button>
                <button class="state-button state-button-hover">
                    Hover State
                </button>
                <button class="state-button state-button-light">
                    Lighter Variant
                </button>
            </div>
        </div>
    </div>
</div>

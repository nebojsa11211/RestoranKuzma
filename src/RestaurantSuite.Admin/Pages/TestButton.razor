@page "/test-button"

<PageTitle>Button Test - Restaurant Suite</PageTitle>

<div id="test-button-page" class="test-button-container">
    <h1 id="test-button-title" class="test-title">Button Styling Test</h1>
    
    <div id="test-button-content" class="space-y-4">
        <div id="test-button-primary-group" class="button-group">
            <h2 id="test-button-primary-title" class="test-section-title">Primary Button Test</h2>
            <button id="test-button-primary-btn" class="primary-button">
                Edit
            </button>
        </div>
        
        <div id="test-button-all-classes-group" class="button-group">
            <h2 id="test-button-all-classes-title" class="test-section-title">Button with All Classes</h2>
            <button id="test-button-all-classes-btn" class="test-button">
                Test Button
            </button>
        </div>
        
        <div id="test-button-states-group" class="button-group">
            <h2 id="test-button-states-title" class="test-section-title">Button States</h2>
            <div id="test-button-states-row" class="button-row">
                <button id="test-button-normal-btn" class="state-button state-button-normal">
                    Normal
                </button>
                <button id="test-button-hover-btn" class="state-button state-button-hover">
                    Hover State
                </button>
                <button id="test-button-light-btn" class="state-button state-button-light">
                    Lighter Variant
                </button>
            </div>
        </div>
    </div>
</div>

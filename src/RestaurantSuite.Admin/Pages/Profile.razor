@page "/profile"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Profile - Restaurant Suite</PageTitle>

<!-- Page Header -->
<div id="profile-header" class="mb-8">
    <div id="profile-header-content" class="flex items-center justify-between">
        <div>
            <h1 id="profile-title" class="text-3xl font-bold text-slate-900">My Profile</h1>
            <p id="profile-subtitle" class="mt-2 text-slate-600">Manage your personal information and preferences</p>
        </div>
    </div>
</div>

<!-- Profile Content -->
<div class="space-y-6">
    <!-- Profile Picture Section -->
    <div id="profile-picture-card" class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Profile Picture</h2>
        <div class="flex items-center space-x-6">
            <div id="profile-avatar" class="w-24 h-24 bg-slate-200 rounded-full flex items-center justify-center">
                <svg class="w-12 h-12 text-slate-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
            </div>
            <div>
                <button class="px-4 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                    Upload New Photo
                </button>
                <p class="mt-2 text-sm text-slate-500">JPG, GIF or PNG. Max size of 2MB</p>
            </div>
        </div>
    </div>

    <!-- Personal Information -->
    <div id="profile-info-card" class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Personal Information</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="form-group">
                <label class="block text-sm font-medium text-slate-700 mb-2">First Name</label>
                <input type="text" @bind="firstName" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            </div>
            <div class="form-group">
                <label class="block text-sm font-medium text-slate-700 mb-2">Last Name</label>
                <input type="text" @bind="lastName" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            </div>
            <div class="form-group">
                <label class="block text-sm font-medium text-slate-700 mb-2">Email</label>
                <input type="email" @bind="email" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            </div>
            <div class="form-group">
                <label class="block text-sm font-medium text-slate-700 mb-2">Phone Number</label>
                <input type="tel" @bind="phoneNumber" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            </div>
            <div class="form-group md:col-span-2">
                <label class="block text-sm font-medium text-slate-700 mb-2">Role</label>
                <input type="text" value="Administrator" disabled class="w-full px-4 py-2 border border-slate-300 rounded-lg bg-slate-50 text-slate-500">
            </div>
        </div>
    </div>

    <!-- Security Settings -->
    <div id="profile-security-card" class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Security</h2>
        <div class="space-y-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Current Password</label>
                <input type="password" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">New Password</label>
                <input type="password" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-2">Confirm New Password</label>
                <input type="password" class="w-full px-4 py-2 border border-slate-300 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-transparent">
            </div>
            <button class="px-4 py-2 bg-slate-600 text-white rounded-lg hover:bg-slate-700 transition-colors">
                Update Password
            </button>
        </div>
    </div>

    <!-- Preferences -->
    <div id="profile-preferences-card" class="bg-white rounded-lg shadow-sm border border-slate-200 p-6">
        <h2 class="text-xl font-semibold text-slate-900 mb-4">Preferences</h2>
        <div class="space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-slate-900">Email Notifications</p>
                    <p class="text-sm text-slate-500">Receive email updates about orders and activity</p>
                </div>
                <input type="checkbox" @bind="emailNotifications" class="w-5 h-5 text-primary-600 rounded focus:ring-primary-500">
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-slate-900">Push Notifications</p>
                    <p class="text-sm text-slate-500">Receive push notifications in the browser</p>
                </div>
                <input type="checkbox" @bind="pushNotifications" class="w-5 h-5 text-primary-600 rounded focus:ring-primary-500">
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-medium text-slate-900">Weekly Reports</p>
                    <p class="text-sm text-slate-500">Receive weekly summary reports via email</p>
                </div>
                <input type="checkbox" @bind="weeklyReports" class="w-5 h-5 text-primary-600 rounded focus:ring-primary-500">
            </div>
        </div>
    </div>

    <!-- Action Buttons -->
    <div class="flex items-center justify-between">
        <button class="px-4 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors">
            Cancel
        </button>
        <button @onclick="SaveProfile" class="px-6 py-2 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
            Save Changes
        </button>
    </div>
</div>
@page "/reports"

<PageTitle>Reports - Restaurant Suite</PageTitle>

<!-- Page Header -->
<div id="reports-header" class="reports-header">
    <div id="reports-header-content" class="reports-header-content">
        <div id="reports-header-text">
            <h1 id="reports-title" class="reports-title">Reports & Analytics</h1>
            <p id="reports-subtitle" class="reports-subtitle">View detailed reports and analytics for your restaurant.</p>
        </div>
        <button id="reports-export-btn" class="export-report-btn">
            <svg id="reports-export-icon" class="export-report-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            Export Report
        </button>
    </div>
</div>

<!-- Report Period Selector -->
<div class="report-period-selector">
    <div class="report-period-content">
        <div class="form-group">
            <label class="form-label">Report Type</label>
            <select class="form-select">
                <option>Sales Summary</option>
                <option>Order Analysis</option>
                <option>Staff Performance</option>
                <option>Menu Performance</option>
                <option>Customer Feedback</option>
            </select>
        </div>
        <div class="form-group">
            <label class="form-label">Start Date</label>
            <input type="date" class="form-input">
        </div>
        <div class="form-group">
            <label class="form-label">End Date</label>
            <input type="date" class="form-input">
        </div>
        <button class="generate-btn">
            Generate
        </button>
    </div>
</div>

<!-- Key Metrics -->
<div class="metrics-grid">
    <div id="total-revenue-metric" class="metric-card">
        <div class="metric-content">
            <div>
                <p class="metric-label">Total Revenue</p>
                <p class="metric-value">RSD 2.4M</p>
                <p class="metric-note">+12.5% vs last month</p>
            </div>
            <div class="metric-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
        </div>
    </div>

    <div id="total-orders-metric" class="metric-card">
        <div class="metric-content">
            <div>
                <p class="metric-label">Total Orders</p>
                <p class="metric-value">3,847</p>
                <p class="metric-note">+8.2% vs last month</p>
            </div>
            <div class="metric-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
            </div>
        </div>
    </div>

    <div id="avg-order-value-metric" class="metric-card">
        <div class="metric-content">
            <div>
                <p class="metric-label">Average Order Value</p>
                <p class="metric-value">RSD 624</p>
                <p class="metric-note">+3.8% vs last month</p>
            </div>
            <div class="metric-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
            </div>
        </div>
    </div>

    <div id="customer-satisfaction-metric" class="metric-card">
        <div class="metric-content">
            <div>
                <p class="metric-label">Customer Satisfaction</p>
                <p class="metric-value">4.7/5</p>
                <p class="metric-note">+0.3 vs last month</p>
            </div>
            <div class="metric-icon">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                </svg>
            </div>
        </div>
    </div>
</div>

<!-- Charts Section -->
<div class="charts-grid">
    <!-- Revenue Chart -->
    <div class="chart-card">
        <div class="chart-header">
            <h2 class="chart-title">Revenue Trend</h2>
            <select class="chart-select">
                <option>Last 7 days</option>
                <option>Last 30 days</option>
                <option>Last 90 days</option>
            </select>
        </div>
        <div class="chart-placeholder">
            <div class="chart-placeholder-content">
                <svg class="chart-placeholder-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
                </svg>
                <p class="chart-placeholder-title">Revenue chart visualization</p>
                <p class="chart-placeholder-subtitle">Interactive chart would be displayed here</p>
            </div>
        </div>
    </div>

    <!-- Orders Chart -->
    <div class="chart-card">
        <div class="chart-header">
            <h2 class="chart-title">Order Volume</h2>
            <select class="chart-select">
                <option>Last 7 days</option>
                <option>Last 30 days</option>
                <option>Last 90 days</option>
            </select>
        </div>
        <div class="chart-placeholder">
            <div class="chart-placeholder-content">
                <svg class="chart-placeholder-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/>
                </svg>
                <p class="chart-placeholder-title">Orders chart visualization</p>
                <p class="chart-placeholder-subtitle">Interactive chart would be displayed here</p>
            </div>
        </div>
    </div>
</div>


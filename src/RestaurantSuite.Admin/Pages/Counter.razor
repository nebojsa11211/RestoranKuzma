@page "/counter"
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Counter</PageTitle>

<div id="counter-page">
    <h1 id="counter-title">Counter</h1>

    <p id="counter-status" role="status">Current count: @currentCount</p>

    <button id="counter-increment-btn" class="btn btn-primary" @onclick="IncrementCount">Click me</button>
</div>

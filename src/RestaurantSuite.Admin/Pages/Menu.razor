    private void ShowEditItemModal(MenuItemDto item)
    {
        editingMenuItemId = item.Id;
        editingMenuItem = new UpdateMenuItemDto
        {
            Name = item.Name,
            Description = item.Description,
            CategoryId = item.CategoryId,
            ImageUrl = item.ImageUrl
        };
        showEditItemModal = true;
    }

    private void HideEditItemModal()
    {
        showEditItemModal = false;
        editingMenuItem = new UpdateMenuItemDto();
        editingMenuItemId = null;
    }

    private async Task HandleEditMenuItem()
    {
        if (editingMenuItemId == null) return;

        try
        {
            // Call the API to update the menu item
            await MenuApiService.UpdateMenuItemAsync(editingMenuItemId.Value, editingMenuItem);

            // Reload the menu data to get the updated list
            await LoadMenuData();

            HideEditItemModal();

            // Show success message
            Console.WriteLine($"Menu item {editingMenuItem.Name} updated successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error updating menu item: {ex.Message}");
            // Show error message (you could add a toast notification here)
        }
    }

    private async Task DeleteMenuItem(Guid itemId)
    {
        // Simple confirmation - in production, you'd want a proper modal
        var item = menuItems.FirstOrDefault(m => m.Id == itemId);
        if (item == null) return;

        try
        {
            // Call the API to delete the menu item
            await MenuApiService.DeleteMenuItemAsync(itemId);

            // Reload the menu data to get the updated list
            await LoadMenuData();

            // Show success message
            Console.WriteLine($"Menu item deleted successfully!");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error deleting menu item: {ex.Message}");
            // Show error message (you could add a toast notification here)
        }
    }

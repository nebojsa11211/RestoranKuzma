@* Edit Staff Modal Component - Placeholder *@
@* TODO: Implement full modular version similar to StaffAddModal *@
@using RestaurantSuite.Application.DTOs

<div class="modal-overlay" @onclick="OnClose">
    <div class="modal" @onclick:stopPropagation="true">
        <div class="modal-header">
            <div class="modal-title-row">
                <h3 class="modal-title">Edit Staff Member</h3>
                <button class="modal-close" @onclick="OnClose">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                    </svg>
                </button>
            </div>
        </div>
        
        <div class="modal-body">
            <p>Edit functionality coming soon...</p>
            <div class="modal-actions">
                <button type="button" class="modal-cancel-btn" @onclick="OnClose">Cancel</button>
                <button type="button" class="modal-submit-btn" @onclick="OnSave">Save Changes</button>
            </div>
        </div>
    </div>
</div>
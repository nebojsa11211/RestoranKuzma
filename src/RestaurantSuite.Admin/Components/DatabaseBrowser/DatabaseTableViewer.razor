@using RestaurantSuite.Application.DTOs.DatabaseBrowser

<div class="db-table-viewer">
    <!-- Header with table info and search -->
    <div class="db-viewer-header">
        <div class="db-viewer-title-section">
            <h2 class="db-viewer-title">@TableName</h2>
            <div class="db-viewer-meta">
                <span>@Schema.Columns.Count columns</span>
                <span>•</span>
                <span>@TableData.TotalRows.ToString("N0") total records</span>
            </div>
        </div>

        <div class="db-viewer-actions">
            <button class="db-btn db-btn-secondary" @onclick="RefreshData">
                🔄 Refresh
            </button>
        </div>
    </div>

    <div class="db-search-bar">
        <input
            type="text"
            class="db-search-input-large"
            placeholder="Search across all text columns..."
            @bind="searchTerm"
            @bind:event="oninput"
            @onkeydown="HandleSearchKeyDown" />
        <button class="db-btn db-btn-primary" @onclick="PerformSearch">
            Search
        </button>
        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <button class="db-btn db-btn-link" @onclick="ClearSearch">
                Clear
            </button>
        }
    </div>

    <!-- Data Table -->
    <div class="db-table-container">
        <table class="db-data-table">
            <thead>
                <tr>
                    @foreach (var column in Schema.Columns)
                    {
                        <th class="@GetColumnClass(column)">
                            <div class="db-column-header" @onclick="() => HandleSort(column.ColumnName)">
                                <span class="db-column-name">@column.ColumnName</span>
                                @if (currentSortColumn == column.ColumnName)
                                {
                                    <span class="db-sort-indicator">@(currentSortDirection == "asc" ? "↑" : "↓")</span>
                                }
                            </div>
                            <div class="db-column-type">
                                @column.DatabaseType
                                @if (column.IsPrimaryKey)
                                {
                                    <span class="db-pk-badge">PK</span>
                                }
                                @if (column.IsForeignKey)
                                {
                                    <span class="db-fk-badge">FK</span>
                                }
                            </div>
                        </th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (TableData.Rows.Any())
                {
                    @foreach (var row in TableData.Rows)
                    {
                        <tr>
                            @foreach (var column in Schema.Columns)
                            {
                                <td>
                                    @FormatCellValue(row, column.ColumnName)
                                </td>
                            }
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="@Schema.Columns.Count" class="db-no-data-cell">
                            <div class="db-no-data">
                                No records found
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    @if (TableData.TotalRows > 0)
    {
        <DatabasePagination
            CurrentPage="@TableData.Page"
            TotalPages="@TableData.TotalPages"
            TotalRecords="@((int)TableData.TotalRows)"
            PageSize="@TableData.PageSize"
            OnPageChanged="@OnPageChanged" />
    }
</div>
@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using RestaurantSuite.Waiter.Services
@using RestaurantSuite.Waiter.Models
<PageTitle>Restaurant Suite - Waiter Portal</PageTitle>

<a href="#main-content" class="skip-to-content">Skip to main content</a>

<div class="flex min-h-screen bg-neutral-50" @onclick="CloseMenus">
    <!-- Sidebar - Desktop -->
    <aside class="@GetSidebarClasses()" @onclick:stopPropagation="true">
        <NavMenu />
    </aside>

    <!-- Mobile Overlay -->
    @if (sidebarOpen)
    {
        <div class="sidebar-overlay" @onclick="ToggleSidebar" aria-label="Close menu"></div>
    }

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col min-h-screen lg:ml-64">
        <!-- Top Navigation Bar -->
        <header class="sticky top-0 z-20 bg-white/80 backdrop-blur-md border-b border-neutral-200 shadow-soft">
            <div class="h-16 px-4 sm:px-6 lg:px-8 flex items-center justify-between">
                <!-- Left Section -->
                <div class="flex items-center gap-3">
                    <!-- Mobile Menu Button -->
                    <button
                        @onclick="ToggleSidebar"
                        class="lg:hidden inline-flex items-center justify-center w-11 h-11 rounded-lg text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 transition-all duration-200"
                        aria-label="Toggle navigation menu"
                        aria-expanded="@sidebarOpen">
                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
                        </svg>
                    </button>

                    <!-- Page Title -->
                    <h1 class="text-base sm:text-lg font-semibold text-neutral-900">Waiter Portal</h1>
                </div>

                <!-- Right Section -->
                <div class="flex items-center gap-2 sm:gap-4">
                    <AuthorizeView>
                        <Authorized>
                            <!-- User Profile Section with Dropdown -->
                            <div class="relative">
                                <!-- Profile Button -->
                                <button
                                    @onclick="ToggleUserMenu"
                                    @onclick:stopPropagation
                                    class="flex items-center gap-3 px-3 py-2 rounded-lg bg-neutral-100/50 hover:bg-neutral-200/50 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 transition-all duration-200 cursor-pointer">
                                    <!-- User Avatar -->
                                    <div class="flex-shrink-0">
                                        <div class="w-9 h-9 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center font-semibold text-sm">
                                            @GetUserInitials()
                                        </div>
                                    </div>
                                    <!-- User Info -->
                                    <div class="hidden sm:block text-left">
                                        <div class="text-sm font-semibold text-neutral-900 leading-tight">
                                            @(currentUser?.FullName ?? "Waiter")
                                        </div>
                                        <div class="text-xs text-neutral-600 leading-tight">
                                            @(currentUser?.Role ?? "Waiter")
                                        </div>
                                    </div>
                                    <!-- Dropdown Icon -->
                                    <svg class="w-4 h-4 text-neutral-600 transition-transform duration-200 @(userMenuOpen ? "rotate-180" : "")" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                                    </svg>
                                </button>

                                <!-- Dropdown Menu -->
                                @if (userMenuOpen)
                                {
                                    <div class="absolute right-0 mt-2 w-80 bg-white rounded-lg shadow-lg border border-neutral-200 py-2 z-50 animate-slide-in-top">
                                        <!-- User Info Header -->
                                        <div class="px-4 py-3 border-b border-neutral-200">
                                            <div class="flex items-center gap-3">
                                                <div class="w-12 h-12 rounded-full bg-primary-100 text-primary-700 flex items-center justify-center font-semibold text-lg">
                                                    @GetUserInitials()
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="text-sm font-semibold text-neutral-900 truncate">
                                                        @(currentUser?.FullName ?? "Waiter")
                                                    </div>
                                                    <div class="text-xs text-neutral-600 truncate">
                                                        @(currentUser?.Email ?? "")
                                                    </div>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- User Details -->
                                        <div class="px-4 py-3 space-y-2 border-b border-neutral-200">
                                            <div class="flex items-center gap-2 text-sm">
                                                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                                                </svg>
                                                <span class="text-neutral-600">Role:</span>
                                                <span class="font-medium text-neutral-900">@(currentUser?.Role ?? "Waiter")</span>
                                            </div>
                                            @if (!string.IsNullOrEmpty(currentUser?.Phone))
                                            {
                                                <div class="flex items-center gap-2 text-sm">
                                                    <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                                    </svg>
                                                    <span class="text-neutral-600">Phone:</span>
                                                    <span class="font-medium text-neutral-900">@currentUser.Phone</span>
                                                </div>
                                            }
                                            <div class="flex items-center gap-2 text-sm">
                                                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                                <span class="text-neutral-600">Status:</span>
                                                <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-green-100 text-green-800">
                                                    Active
                                                </span>
                                            </div>
                                        </div>

                                        <!-- Actions -->
                                        <div class="px-2 py-2">
                                            <button
                                                @onclick="HandleLogout"
                                                class="w-full flex items-center gap-3 px-3 py-2 text-sm text-red-600 hover:bg-red-50 rounded-lg transition-all duration-200 group">
                                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                                                </svg>
                                                <span class="font-medium">Logout</span>
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                        </Authorized>
                        <NotAuthorized>
                            <!-- Help Link (shown when not logged in) -->
                            <a
                                href="https://learn.microsoft.com/aspnet/core/"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-2 px-3 py-2 rounded-lg text-sm font-medium text-neutral-700 hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none focus:ring-2 focus:ring-primary-600 focus:ring-offset-2 transition-all duration-200">
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16v-4m0-4h.01"/>
                                </svg>
                                <span class="hidden sm:inline">Help</span>
                            </a>
                        </NotAuthorized>
                    </AuthorizeView>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main id="main-content" class="flex-1 p-4 sm:p-6 lg:p-8 animate-slide-in-bottom">
            <div class="max-w-7xl mx-auto">
                @Body
            </div>
        </main>
    </div>
</div>
<!-- Brand Section -->
<div class="h-16 px-5 border-b border-neutral-200 flex items-center justify-between bg-gradient-to-r from-white to-neutral-50">
    <div class="flex items-center gap-3">
        <!-- Brand Icon -->
        <div class="flex-shrink-0">
            <svg class="w-8 h-8 text-primary-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 2L3 7V17C3 18.1046 3.89543 19 5 19H19C20.1046 19 21 18.1046 21 17V7L12 2Z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 22V19"/>
                <circle cx="12" cy="12" r="2" fill="currentColor"/>
            </svg>
        </div>
        <!-- Brand Name -->
        <div class="flex flex-col">
            <span class="text-lg font-bold text-neutral-900 leading-tight">Restaurant</span>
            <span class="text-xs font-medium text-primary-600 leading-tight">Waiter Suite</span>
        </div>
    </div>

    <!-- Mobile Close Button -->
    <button
        @onclick="ToggleNavMenu"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg text-neutral-500 hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none focus:ring-2 focus:ring-primary-600 transition-all duration-200"
        aria-label="Close menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
    </button>
</div>

<!-- Navigation Menu -->
<nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto scrollbar-thin" aria-label="Main navigation">
    <!-- Dashboard -->
    <NavLink href="" Match="NavLinkMatch.All" class="@GetNavLinkClasses()">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
            <polyline stroke-linecap="round" stroke-linejoin="round" stroke-width="2" points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span class="font-medium">Dashboard</span>
    </NavLink>

    <!-- Tables -->
    <NavLink href="tables" class="@GetNavLinkClasses()">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <rect stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x="3" y="3" width="7" height="7"/>
            <rect stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x="14" y="3" width="7" height="7"/>
            <rect stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x="14" y="14" width="7" height="7"/>
            <rect stroke-linecap="round" stroke-linejoin="round" stroke-width="2" x="3" y="14" width="7" height="7"/>
        </svg>
        <span class="font-medium">Tables</span>
    </NavLink>

    <!-- Invoices -->
    <NavLink href="invoices" class="@GetNavLinkClasses()">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
        </svg>
        <span class="font-medium">Invoices</span>
    </NavLink>

    <!-- Reservations -->
    <NavLink href="reservations" class="@GetNavLinkClasses()">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
        </svg>
        <span class="font-medium">Reservations</span>
    </NavLink>

    <!-- Order Entry -->
    <NavLink href="order-entry" class="@GetNavLinkClasses()">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
        </svg>
        <span class="font-medium">Order Entry</span>
    </NavLink>

    <!-- Payment -->
    <NavLink href="payment" class="@GetNavLinkClasses()">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
        </svg>
        <span class="font-medium">Payment</span>
    </NavLink>

    <!-- Notifications -->
    <NavLink href="notifications" class="@GetNavLinkClasses()">
        <svg class="w-5 h-5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.73 21a2 2 0 0 1-3.46 0"/>
        </svg>
        <span class="font-medium">Notifications</span>
        @if (unreadCount > 0)
        {
            <span class="ml-auto inline-flex items-center justify-center px-2 py-1 text-xs font-bold leading-none text-white bg-red-600 rounded-full">@unreadCount</span>
        }
    </NavLink>
</nav>

<!-- Footer Section (Optional) -->
<div class="px-5 py-4 border-t border-neutral-200 bg-gradient-to-r from-neutral-50 to-white">
    <div class="flex items-center gap-2 text-xs text-neutral-500">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="2"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6l4 2"/>
        </svg>
        <span>v1.0.0</span>
    </div>
</div>
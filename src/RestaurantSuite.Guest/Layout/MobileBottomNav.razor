@* Mobile Bottom Navigation Component with More Menu *@
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<nav class="mobile-bottom-nav" aria-label="Mobile bottom navigation">
    <NavLink href="" Match="NavLinkMatch.All" class="bottom-nav-item" ActiveClass="active">
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span class="bottom-nav-label">Home</span>
    </NavLink>

    <NavLink href="menu" class="bottom-nav-item" ActiveClass="active">
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <span class="bottom-nav-label">Menu</span>
    </NavLink>

    <NavLink href="order" class="bottom-nav-item" ActiveClass="active">
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span class="bottom-nav-label">Order</span>
    </NavLink>

    <button @onclick="ToggleMoreMenu" class="bottom-nav-item @(IsMoreMenuActive() ? "active" : "")" aria-label="More menu" aria-expanded="@IsMoreMenuOpen">
        @if (UnreadCount > 0)
        {
            <span class="badge" aria-label="@UnreadCount unread messages">@UnreadCount</span>
        }
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="5" cy="12" r="1"/>
            <circle cx="12" cy="12" r="1"/>
            <circle cx="19" cy="12" r="1"/>
        </svg>
        <span class="bottom-nav-label">More</span>
    </button>
</nav>

@* Overlay for bottom sheet *@
@if (IsMoreMenuOpen)
{
    <div class="mobile-bottom-sheet-overlay" @onclick="CloseMoreMenu" aria-hidden="true"></div>
}

@* More Menu Bottom Sheet *@
<div class="mobile-bottom-sheet @(IsMoreMenuOpen ? "open" : "")"
     id="more-menu-sheet"
     role="dialog"
     aria-modal="true"
     aria-label="More menu options"
     @ontouchstart="HandleTouchStart"
     @ontouchmove="HandleTouchMove"
     @ontouchend="HandleTouchEnd">

    <div class="mobile-bottom-sheet-handle" aria-hidden="true"></div>

    <div class="mobile-bottom-sheet-header">
        <h2 class="mobile-bottom-sheet-title">More Options</h2>
        <button @onclick="CloseMoreMenu" class="mobile-bottom-sheet-close" aria-label="Close menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
            </svg>
        </button>
    </div>

    <div class="mobile-bottom-sheet-content">
        @* Daily Menu - if enabled *@
        @if (IsDailyMenuEnabled)
        {
            <a href="daily-menu" @onclick="CloseMoreMenu" class="more-menu-item">
                <div class="more-menu-icon-wrapper daily">
                    <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
                    </svg>
                </div>
                <div class="more-menu-text">
                    <span class="more-menu-label">Daily Special</span>
                    <span class="more-menu-description">Today's featured dishes</span>
                </div>
                <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                </svg>
            </a>
        }

        @* Chat Support *@
        <a href="chat" @onclick="CloseMoreMenu" class="more-menu-item">
            <div class="more-menu-icon-wrapper chat">
                <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
                </svg>
            </div>
            <div class="more-menu-text">
                <span class="more-menu-label">Chat Support</span>
                <span class="more-menu-description">Get help from our staff</span>
            </div>
            @if (UnreadCount > 0)
            {
                <span class="more-menu-badge">@UnreadCount</span>
            }
            <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
        </a>

        @* Tables & Reservations *@
        <a href="tables" @onclick="CloseMoreMenu" class="more-menu-item">
            <div class="more-menu-icon-wrapper tables">
                <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M3 14h18m-9-4v8m-7 0h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"/>
                </svg>
            </div>
            <div class="more-menu-text">
                <span class="more-menu-label">Tables & Reserve</span>
                <span class="more-menu-description">Book your table</span>
            </div>
            <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
        </a>

        @* Location *@
        <a href="location" @onclick="CloseMoreMenu" class="more-menu-item">
            <div class="more-menu-icon-wrapper location">
                <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <div class="more-menu-text">
                <span class="more-menu-label">Location</span>
                <span class="more-menu-description">Find us on the map</span>
            </div>
            <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
        </a>

        @* User-specific items *@
        <AuthorizeView>
            <Authorized>
                @* My Orders *@
                <a href="my-orders" @onclick="CloseMoreMenu" class="more-menu-item">
                    <div class="more-menu-icon-wrapper orders">
                        <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"/>
                        </svg>
                    </div>
                    <div class="more-menu-text">
                        <span class="more-menu-label">My Orders</span>
                        <span class="more-menu-description">View order history</span>
                    </div>
                    <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>

                @* Divider *@
                <div class="more-menu-divider"></div>

                @* Profile *@
                <button @onclick="() => { HandleProfile(); CloseMoreMenu(); }" class="more-menu-item">
                    <div class="more-menu-icon-wrapper profile">
                        <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                            <circle cx="12" cy="7" r="4"/>
                        </svg>
                    </div>
                    <div class="more-menu-text">
                        <span class="more-menu-label">Profile</span>
                        <span class="more-menu-description">@GetUserName(context.User)</span>
                    </div>
                    <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>

                @* Logout *@
                <button @onclick="() => { HandleLogout(); CloseMoreMenu(); }" class="more-menu-item logout">
                    <div class="more-menu-icon-wrapper logout">
                        <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                        </svg>
                    </div>
                    <div class="more-menu-text">
                        <span class="more-menu-label">Logout</span>
                        <span class="more-menu-description">Sign out of your account</span>
                    </div>
                    <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </button>
            </Authorized>
            <NotAuthorized>
                @* Divider *@
                <div class="more-menu-divider"></div>

                @* Login *@
                <a href="login" @onclick="CloseMoreMenu" class="more-menu-item">
                    <div class="more-menu-icon-wrapper login">
                        <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"/>
                        </svg>
                    </div>
                    <div class="more-menu-text">
                        <span class="more-menu-label">Login</span>
                        <span class="more-menu-description">Sign in to your account</span>
                    </div>
                    <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>

                @* Register *@
                <a href="register" @onclick="CloseMoreMenu" class="more-menu-item">
                    <div class="more-menu-icon-wrapper register">
                        <svg class="more-menu-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                        </svg>
                    </div>
                    <div class="more-menu-text">
                        <span class="more-menu-label">Register</span>
                        <span class="more-menu-description">Create an account</span>
                    </div>
                    <svg class="more-menu-arrow" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                    </svg>
                </a>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

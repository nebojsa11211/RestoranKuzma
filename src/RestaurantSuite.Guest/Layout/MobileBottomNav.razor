@* Mobile Bottom Navigation Component *@
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<nav class="mobile-bottom-nav" aria-label="Mobile bottom navigation">
    <NavLink href="" Match="NavLinkMatch.All" class="bottom-nav-item" ActiveClass="active">
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/>
            <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        <span class="bottom-nav-label">Home</span>
    </NavLink>

    <NavLink href="menu" class="bottom-nav-item" ActiveClass="active">
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.746 0 3.332.477 4.5 1.253v13C19.832 18.477 18.246 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
        </svg>
        <span class="bottom-nav-label">Menu</span>
    </NavLink>

    <NavLink href="order" class="bottom-nav-item" ActiveClass="active">
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="21" r="1"/>
            <circle cx="20" cy="21" r="1"/>
            <path d="M1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"/>
        </svg>
        <span class="bottom-nav-label">Order</span>
    </NavLink>

    <NavLink href="tables" class="bottom-nav-item" ActiveClass="active">
        <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="8" width="18" height="12" rx="2"/>
            <path d="M3 10h18"/>
        </svg>
        <span class="bottom-nav-label">Tables</span>
    </NavLink>

    <AuthorizeView>
        <Authorized>
            <button @onclick="HandleProfile" class="bottom-nav-item @(IsProfileActive() ? "active" : "")" aria-label="Profile">
                <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span class="bottom-nav-label">Profile</span>
            </button>
        </Authorized>
        <NotAuthorized>
            <NavLink href="login" class="bottom-nav-item" ActiveClass="active">
                <svg class="bottom-nav-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/>
                    <polyline points="10 17 15 12 10 7"/>
                    <line x1="15" y1="12" x2="3" y2="12"/>
                </svg>
                <span class="bottom-nav-label">Login</span>
            </NavLink>
        </NotAuthorized>
    </AuthorizeView>
</nav>

@code {
    [Inject] private NavigationManager NavigationManager { get; set; } = default!;

    private void HandleProfile()
    {
        NavigationManager.NavigateTo("/profile");
    }

    private bool IsProfileActive()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        return uri.AbsolutePath.StartsWith("/profile", StringComparison.OrdinalIgnoreCase);
    }
}
